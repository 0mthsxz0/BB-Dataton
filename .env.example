# Referência: defina estas variáveis no ambiente. O app não carrega .env automaticamente.
TWILIO_ACCOUNT_SID=AC_COLOQUE_SEU_ACCOUNT_SID
TWILIO_AUTH_TOKEN=COLOQUE_SEU_AUTH_TOKEN
# Padrão gratuito: a Twilio escolhe a origem e usa um template de demonstração.
TWILIO_MODE=trial
# Apenas no modo completo, com conta habilitada para uso pago:
# TWILIO_MODE=completo
# TWILIO_FROM_NUMBER=+NUMERO_AUTORIZADO_PELA_TWILIO
